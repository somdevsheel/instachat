# ==================================================
# SECRETS & MANAGED CONFIG (KEEP LOCAL ONLY)
# ==================================================
backend/.env
backend/.env.*
.env
.env.*
*.csv

# .env.example files ARE meant to be committed (templates with no real
# secrets) — the .env.* rules above catch these too, so un-ignore them.
!.env.example
!**/.env.example

# ==================================================
# BACKEND LOCAL / SCRIPT FILES
# ==================================================
backend/cleanup-old-messages.js

# ==================================================
# NODE DEPENDENCIES (KEEP LOCAL)
# ==================================================
node_modules/

