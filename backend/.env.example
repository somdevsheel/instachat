# ------------------------------------------------------------------
# InstaChat backend — copy to `.env` and fill in. Never commit `.env`.
# ------------------------------------------------------------------

# App
PORT=5000
NODE_ENV=production

# Comma-separated browser origins allowed by CORS (REST + Socket.IO).
# Required in production — otherwise every browser request is rejected.
# Native mobile apps send no Origin header and are unaffected.
ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# Auth — use a long random value, e.g. `openssl rand -hex 48`.
# Production refuses to boot with a secret shorter than 32 chars.
JWT_SECRET=
# Login session lifetime (no refresh tokens — users re-login after this).
JWT_EXPIRES_IN=30d

# MongoDB
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/instachat

# PostgreSQL (social graph: follows, blocks, mutes, close friends).
# Create tables with `npm run db:migrate` before starting the server.
POSTGRES_URL=postgres://USER:PASSWORD@db.example.com:5432/instachat
# "true" for managed providers that require TLS (RDS, Neon, Supabase...)
POSTGRES_SSL=true
POSTGRES_POOL_MAX=10

# Redis (presence + rate limiting). Use REDIS_URL, or HOST/PORT/PASSWORD.
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# AWS S3 / CDN (media uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=ap-south-1
CDN_BASE_URL=https://cdn.example.com

# SMTP (OTP emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=

# ------------------------------------------------------------------
# Operations
# ------------------------------------------------------------------
# Error reporting (Sentry). Leave empty to disable.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# error | warn | info | debug  (production default: info, JSON lines)
LOG_LEVEL=info

# Multi-process support. Both default to "redis" when NODE_ENV=production.
RATE_LIMIT_STORE=redis
SOCKET_ADAPTER=redis
# Set per environment if several share one Redis.
SOCKET_ADAPTER_KEY=socket.io

# Off-site backups (ops/backup.sh)
BACKUP_S3_URI=s3://instachat-backups/prod
