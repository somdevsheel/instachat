# Production builds REQUIRE these (the Content-Security-Policy is built
# from them; `vite build` fails if one is missing).
VITE_API_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:5000
# Where media is served from (CloudFront) and the S3 bucket presigned
# uploads go to, e.g. https://instachat-media-prod.s3.ap-south-1.amazonaws.com
VITE_CDN_URL=https://cdn.example.com
VITE_S3_BUCKET_URL=https://your-bucket.s3.your-region.amazonaws.com
